# Choose one: fake (offline), openai, anthropic, or opencode.
AUTOANALYST_LLM_PROVIDER=fake
# Optional shared model override; provider-specific model variables are below.
AUTOANALYST_LLM_MODEL=
AUTOANALYST_LLM_TEMPERATURE=0

# OpenAI or any OpenAI-compatible chat-completions endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Native Anthropic Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Optional: true/false. Auto: strict schema for Claude model IDs, prompt-JSON otherwise.
ANTHROPIC_STRUCTURED_OUTPUTS=

# OpenCode V2 server (model is optional; if set use providerID/modelID).
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_TOKEN=
OPENCODE_MODEL=

AUTOANALYST_DATASET=data/online_retail.sqlite
AUTOANALYST_OUTPUT=output
